{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.svg", "/*.css", "/*.js", "/fonts/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/maps/**", "/machines/**", "/worlds/**", "/draco/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "progress",
      "urls": ["/api/progress"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "30d"
      }
    }
  ]
}
