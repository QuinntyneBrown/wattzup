{
  "name": "telo-ride",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ride",
    "start:marketing": "npm run media:sync && ng serve marketing",
    "build": "ng build ride",
    "bundle:size": "node scripts/bundle-size.mjs",
    "build:marketing": "npm run media:sync && ng build marketing",
    "media:sync": "node scripts/media-sync.mjs",
    "watch": "ng build ride --watch --configuration development",
    "test": "ng test ride --watch=false",
    "lint": "ng lint && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "heap": "playwright test -c playwright.heap.config.ts",
    "perf": "playwright test -c playwright.perf.config.ts",
    "sweep:responsive": "playwright test -c playwright.sweeps.config.ts e2e/sweeps/responsive.sweep.ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.3.0",
    "@microsoft/signalr": "10.0.11",
    "3d-tiles-renderer": "0.5.4",
    "rxjs": "~7.8.0",
    "three": "0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.187.0",
    "@types/web-bluetooth": "^0.0.22",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
