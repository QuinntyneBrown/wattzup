@startuml
!include <C4/C4_Component>
title Components: play ride sound
Person(rider, "Rider")
System_Ext(browser, "Browser Web Audio", "AudioContext, oscillators, noise buffers, filters")
Container_Boundary(app, "Wattzup app (wattzup project)") {
  Component(live, "LiveStateService", "core/", "The live state signal: cadence, speed_kmh, resistance, status, ble")
  Component(params, "rideSoundParams()", "core/ride-sound.ts", "Pure helper: live state and volume to chain, freewheel, wind and tyre parameters")
  Component(service, "RideSound", "core/ride-sound.service.ts", "Owns the ride sound AudioContext and its voices; on/off, volume, gates")
  Component(cue, "CueService", "core/cue.service.ts", "Countdown beeps; reports each beep for ducking")
  Component(video, "VideoSync", "core/video-sync.service.ts", "The ride-along player; reports whether it plays")
  Component(button, "Ride sound button", "AppBar, WorldRide", "Ride sound off / on; opens the dialog")
  Component(dialog, "RideSoundDialog", "dashboard/ride-sound-dialog/", "CDK Dialog: switch and Volume slider")
}
Rel(rider, button, "Presses")
Rel(button, dialog, "Opens")
Rel(dialog, service, "turnOn() / turnOff() / setVolume()")
Rel(service, live, "Reads state()")
Rel(service, params, "Computes parameters each state")
Rel(cue, service, "Beep: duck")
Rel(video, service, "Playing: mute")
Rel(service, browser, "Sets voice rates, gains and filters")
@enduml
