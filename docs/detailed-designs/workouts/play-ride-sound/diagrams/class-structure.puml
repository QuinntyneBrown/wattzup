@startuml
hide empty members
class RideSound <<root service>> {
  + on: Signal<boolean>
  + volume: Signal<number>
  + turnOn(): void  ' inside the rider's press
  + turnOff(): void
  + setVolume(percent: number): void
  + duck(seconds: number): void
  + setVideoPlaying(playing: boolean): void
  - context: AudioContext | null
  - voices: ChainVoice, FreewheelVoice, NoiseVoice x2
}
class "rideSoundParams()" as Params <<pure helper>> {
  (input: RideSoundInput) : RideSoundParams
}
class RideSoundInput {
  cadence: number | null
  speedKmh: number | null
  resistance: number | null
  audible: boolean
  volume: number
  freewheel: FreewheelState | null
  now: number
}
class RideSoundParams {
  chain: {ticksPerSecond, gain}
  freewheel: {clicksPerSecond, gain}
  wind: {cutoffHz, gain}
  tyre: {centreHz, gain}
}
class FreewheelState {
  fromKmh: number
  startedAt: number
}
class RideSoundPreference <<root service>> {
  + volume: Signal<number>  ' 60 by default
  + setVolume(percent): void
}
class LiveStateService
class CueService {
  + beeped: Signal<Beep | null>
}
class VideoSync {
  + playing: Signal<boolean>
}
RideSound --> LiveStateService : state()
RideSound ..> Params
Params ..> RideSoundInput
Params ..> RideSoundParams
RideSoundInput --> FreewheelState
RideSound --> RideSoundPreference
RideSound <.. CueService : beeped
RideSound <.. VideoSync : playing (via RidePage)
@enduml
