@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Inspect diagnostics
Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(app, "Ride app") {
  Component(opener, "Profile / Settings bike row, RideHeader status", "Angular pages · ride; presentation · components", "Opens Diagnostics")
  Component(launcher, "openDiagnostics()", "Function · ride", "Lazy-loads and opens the dialog with CDK Dialog")
  Component(dialog, "DiagnosticsDialog", "Angular dialog · ride", "Modal labelled Diagnostics; provides BrowserDiagnostics")
  Component(panel, "DiagnosticsPanel", "Presentation component · components", "Title, close, facts, privacy note")
  Component(reporter, "BrowserDiagnostics", "Service · domain/diagnostics", "Gathers the inputs of diagnosticsFacts()")
  Component(history, "BikeConnectionHistory", "Service · domain/diagnostics", "Connected since, reconnects; saves the bike as seen")
  Component(conn, "BikeConnection", "Contract · api", "Bike and ble state")
  Component(support, "BluetoothSupport", "Contract · api", "Web Bluetooth availability")
  Component(sent, "ResistanceController", "Service · domain/engine", "Last command, on a ride")
  ComponentDb(waiting, "RidesWaiting", "Store · api contract", "Rides waiting to send")
  ComponentDb(remembered, "RememberedBikeStore", "Store · domain/storage", "Remembered bike, last seen")
  Component(build, "BUILD_INFO", "Injection token · api", "App version and client commit")
}
Rel(rider, opener, "Chooses Diagnostics")
Rel(opener, launcher, "openDiagnostics(dialog, injector)")
Rel(launcher, dialog, "Opens; the focus goes back on close")
Rel(dialog, reporter, "Reads facts via DIAGNOSTICS")
Rel(dialog, panel, "Renders")
Rel(reporter, history, "Reads via CONNECTION_HISTORY")
Rel(history, conn, "Follows ble")
Rel(reporter, conn, "Reads")
Rel(reporter, support, "Reads")
Rel(reporter, sent, "Reads last, where in reach")
Rel(reporter, waiting, "Counts")
Rel(reporter, remembered, "Reads")
Rel(reporter, build, "Reads")
@enduml
