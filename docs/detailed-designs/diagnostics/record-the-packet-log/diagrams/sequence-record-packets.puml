@startuml
title UML sequence behaviour — Record packets
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "DiagnosticsDialog" as dialog
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "WebBluetoothBikeConnection" as conn
  participant "MemoryPacketLog" as log
  participant "ConsoleAppLogger" as logger
end box
box "Device — Smart bike" #F2F4F7
  participant "Bike GATT server" as bike
end box
alt Log every packet off (default)
  conn -> log : record(out, write, F0 B1 01 08 AA)
  log -> log : keep {time, direction, frame type, hex} as a JSON line
  conn -> log : record(in, notify, D1 frame)
  log -> log : not a command: not kept, no console line (L2-114 AC1, L2-115 AC2)
  log --> dialog : "212 commands · 20 KB"
else rider turns the switch on
  actor -> dialog : Toggle "Log every packet" (role="switch")
  dialog -> log : setEveryPacket(true)
  bike -> conn : notification
  conn -> log : record(in, notify, bytes)
  log -> log : keep {time, direction, frame type, hex} (L2-114 AC2)
  log -> logger : packet(in, D1, hex): console.debug only
  log --> dialog : "1,284 packets · 186 KB" with "Recording" tag
end
opt log reaches 10 MB
  log -> log : drop the oldest entries (L2-114 AC4)
end
@enduml
