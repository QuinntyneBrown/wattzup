@startuml
title UML sequence behaviour — Download the packet log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "DiagnosticsDialog" as dialog
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "MemoryPacketLog" as exporter
end box
box "Device — Browser" #F2F4F7
  participant "Downloads" as browser
end box
dialog --> actor : "Saves telo-ride-packets-{date}.jsonl. Attach it to a bug report if we ask."
actor -> dialog : Download packet log
dialog -> exporter : download()
exporter -> exporter : The kept entries, oldest first, one JSON object per line (L2-114 AC3)
exporter -> browser : Blob, object URL, a[download="telo-ride-packets-YYYY-MM-DD.jsonl"]
exporter -> exporter : URL.revokeObjectURL on the next task
browser --> actor : File saved on the device only (L2-114 AC5)
@enduml
