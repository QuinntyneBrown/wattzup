@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Record the packet log
Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(app, "Ride app") {
  Component(dialog, "DiagnosticsDialog", "Angular dialog · ride", "Reads PACKET_LOG, formats the count")
  Component(panel, "DiagnosticsPanel", "Presentation component · components", "Log every packet (Switch, role=switch), count, download")
  Component(conn, "WebBluetoothBikeConnection and its links", "Services · domain/bluetooth", "Tap every write and notification")
  Component(log, "MemoryPacketLog", "PacketLog · domain/diagnostics", "Mode, entries as JSON lines, 10 MB window, download")
  Component(frame, "packetFrame(), toHex()", "Pure helpers · domain/protocol", "Frame type and hex bytes")
  Component(summary, "packetLogSummary()", "Pure helper · domain/diagnostics", "212 commands · 20 KB")
  Component(logger, "ConsoleAppLogger", "AppLogger · domain/diagnostics", "Browser console only; redacts")
}
Rel(rider, panel, "Toggles, downloads")
Rel(dialog, panel, "Renders")
Rel(dialog, log, "Reads count, sets mode, download()")
Rel(dialog, summary, "Formats")
Rel(conn, log, "record(direction, characteristic, bytes)")
Rel(log, frame, "Names and encodes")
Rel(log, logger, "packet() only while Log every packet is on")
Rel(conn, logger, "error('bluetooth', error)")
@enduml
