@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Ride a class

Container_Boundary(app, "Ride app") {
  Component(page, "ClassRidePage", "Angular page · ride", "Route /classes/:id/ride")
  Component(store, "ClassRideStore", "Signal store · ride", "Class ride state")
  Component(header, "ClassHeader", "Presentation component · components", "Title, clock, Leave, Pause")
  Component(bikepanel, "ClassBike", "Presentation component · components", "Segment, power, cadence, stepper")
  Component(video, "ClassVideo", "Presentation component · components", "Player host and notice")
  Component(clock, "RideClock", "Service · domain/engine", "performance.now() elapsed")
  Component(engine, "WorkoutEngine", "Service · domain/engine", "Current segment and targets")
  Component(sync, "VideoClockSync", "Rule · domain/engine", "Drift above 1.5 s → seek")
  Component(resist, "ResistanceController", "Service · domain/engine", "Target resistance")
  Component(conn, "WebBluetoothBikeConnection", "Service · domain/bluetooth", "BIKE_CONNECTION")
  Component(player, "YouTubeVideoPlayer", "Service · video", "VIDEO_PLAYER_FACTORY")
  Component(live, "LiveSessionStore", "Signal store · ride", "Group only: session state")
  Component(hub, "SignalRRideHubClient", "Hub client · api", "RIDE_HUB_CLIENT")
}
System_Ext(bike, "Smart bike", "Bluetooth LE")
System_Ext(youtube, "YouTube", "Embed")
Rel(page, store, "Reads signals")
Rel(page, header, "Renders")
Rel(page, bikepanel, "Renders")
Rel(page, video, "Renders")
Rel(store, engine, "Follows plan")
Rel(store, sync, "Ticks")
Rel(engine, clock, "Reads elapsed")
Rel(sync, clock, "Reads elapsed")
Rel(engine, resist, "Segment level")
Rel(resist, conn, "Set resistance")
Rel(store, conn, "Reads telemetry")
Rel(sync, player, "play, pause, seekTo")
Rel(store, live, "Session start (group)")
Rel(live, hub, "ServerTime, JoinClassSession: seat and start")
Rel(conn, bike, "GATT", "Web Bluetooth")
Rel(player, youtube, "IFrame API")
@enduml
