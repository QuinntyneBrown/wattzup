@startuml
title UML sequence behaviour — Wait for the group start
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "ClassRidePage" as page
  participant "ClassRideStore" as store
  participant "LiveSessionStore" as live
end box
box "Frontend — Ride app (api, domain and video libraries)" #E0F2FE
  participant "SignalRRideHubClient" as hub
  participant "RideClock" as clock
  participant "WorkoutEngine" as engine
  participant "YouTubeVideoPlayer" as player
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHub" as rhub
end box
rider -> page : Arrive after joining (?session=id)
page -> store : init(class, Group)
store -> live : join(class, session)
live -> hub : ServerTime x5, JoinClassSession
hub -> rhub : invoke
rhub --> hub : Seat (startsAt, server time)
live --> store : seat, offsetMs (L2-121 AC3)
store -> store : deadline = startsAt - offsetMs
store -> player : load at sync offset, autoplay off (parked)
store --> page : Clock 0:00, "Starts in 9:00" on whole seconds (L2-087 AC4)
store -> clock : start(deadline) at the deadline (or at once, from it, if past)
store -> engine : follow(plan)
store -> player : seekTo(offset + elapsed), play()
page --> rider : Header "30 Minute HIIT Cardio · Group", clock running
@enduml
