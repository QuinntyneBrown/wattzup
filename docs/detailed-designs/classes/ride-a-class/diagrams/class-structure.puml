@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Ride a class

package "domain library" {
  class RideClock {
    +elapsed: Signal<number>
    +running: Signal<boolean>
    +start(): void
    +startAt(serverTimeMs: number, clock: ServerClock): void
    +pause(): void
    +resume(): void
  }
  class WorkoutEngine {
    +state: Signal<PlanState | null>
    +follow(plan: Plan): void
  }
  class PlanState {
    +index: number
    +segment: Segment
    +remainingMs: number
    +progress: number
    +targetPower: number
  }
  class Plan {
    +segments: Segment[]
  }
  class Segment {
    +kind: SegmentKind
    +duration: number
    +level: number
    +cadenceAim: number
  }
  enum SegmentKind {
    warm-up
    work
    recover
    steady
    cool-down
  }
  class PowerModel {
    +estimate(cadence: number, resistance: number): number
    +target(cadenceAim: number, level: number): number
    +onTarget(power: number, target: number): boolean
  }
  class VideoClockSync {
    +driftLimitSeconds = 1.5
    +check(videoTime: number, elapsed: number, offset: number): number | null
  }
  class ResistanceController {
    +applyPlanLevel(level: number): Promise<void>
    +nudge(delta: 1 | -1): Promise<void>
  }
}
package "api library" {
  interface VideoPlayer {
    +state: Signal<PlayerState>
    +load(host: HTMLElement, videoId: string, options: PlayerOptions): Promise<void>
    +currentTime(): number
    +play(): void
    +pause(): void
    +seekTo(seconds: number): void
    +destroy(): void
  }
  interface ClassesApi {
    +get(id: string): Observable<ClassDto>
  }
  class ClassDto {
    +id: string
    +title: string
    +lengthSeconds: number
    +plan: Plan
    +video: VideoDto
  }
  class VideoDto {
    +videoId: string
    +syncOffsetSeconds: number
  }
  interface BikeConnection {
    +ble: Signal<BleState>
    +telemetry: Signal<Telemetry>
  }
}
package "ride application" {
  class ClassRideStore {
    +mode: Signal<RideMode>
    +sessionStartsAt: Signal<number>
    +header: Signal<ClassHeaderView>
    +segmentCard: Signal<SegmentCardView>
    +power: Signal<StatView>
    +cadence: Signal<StatView>
    +video: Signal<VideoView>
    +raise(): void
    +lower(): void
  }
}
ClassRideStore *-- WorkoutEngine
ClassRideStore *-- RideClock
ClassRideStore *-- VideoClockSync
ClassRideStore ..> VideoPlayer
ClassRideStore ..> BikeConnection
ClassRideStore ..> ClassesApi : get(id)
WorkoutEngine --> Plan
WorkoutEngine ..> PlanState
WorkoutEngine ..> RideClock
WorkoutEngine ..> PowerModel
WorkoutEngine ..> ResistanceController
Plan "1" *-- "*" Segment
Segment --> SegmentKind
@enduml
