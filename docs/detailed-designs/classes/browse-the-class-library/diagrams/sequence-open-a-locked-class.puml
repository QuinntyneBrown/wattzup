@startuml
title UML sequence behaviour — Open a locked class's address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "Router" as router
  participant "classUnlockedGuard" as guard
  participant "ClassLibraryStore" as store
  participant "ClassLibraryPage" as page
end box
rider -> router : Open /classes/vice-city-pyramid
router -> guard : canActivate
guard -> store : isLocked("vice-city-pyramid")
store --> guard : true (opens at 10, rider level 7)
guard --> router : UrlTree /classes L2-082 AC4
router -> page : Activate Class Library
page --> rider : Class Library with the card shown as locked
@enduml
