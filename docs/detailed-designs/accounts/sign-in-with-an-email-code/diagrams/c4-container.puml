@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in with an email code
Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(email, "Email delivery service", "Delivers sign-in codes; provider <TO SUPPLY>")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Sign-in and code screens, route guard")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Issues and confirms codes, starts sessions")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Riders, code hashes, sessions")
}
Rel(rider, app, "Uses", "HTTPS")
Rel(app, api, "POST /api/auth/code, POST /api/auth/code/confirm", "JSON/HTTPS")
Rel(api, db, "Reads and writes riders, codes and sessions", "EF Core")
Rel(api, email, "Sends the code", "<TO SUPPLY>")
@enduml
