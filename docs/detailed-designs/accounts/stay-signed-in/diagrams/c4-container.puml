@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Stay signed in
Person(rider, "Rider", "Rides a smart bike at home")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Learns who is signed in; keeps rides while signed out")
  ContainerDb(idb, "Browser storage", "IndexedDB", "Rides waiting to send")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Validates the session cookie and slides its expiry")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Rider sessions")
}
Rel(rider, app, "Uses", "HTTPS")
Rel(app, api, "Sends every request with the session cookie", "JSON/HTTPS")
Rel(app, idb, "Keeps finished rides while signed out", "IndexedDB")
Rel(api, db, "Reads and updates RiderSession", "EF Core")
@enduml
