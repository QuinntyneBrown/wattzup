@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Stay signed in
Container_Boundary(app, "Ride app") {
  Component(current, "CurrentRiderStore", "Store on the screens' parent route · ride, behind CURRENT_RIDER", "Signed-in rider or none, loaded from GET /api/riders/me")
  Component(interceptor, "sessionInterceptor", "HTTP interceptor · api", "Turns any 401 into a signed-out state")
  Component(guard, "authGuard", "Route guard · ride", "Sends a rider with no session to sign-in")
  Component(outbox, "RideOutbox", "Service · domain/storage", "Keeps finished rides until they are recorded")
}
Container_Boundary(api, "Telo Ride API") {
  Component(cookie, "Cookie authentication", "ASP.NET Core authentication · Telo.Ride.Api", "Session cookie: HttpOnly, Secure, SameSite=Lax")
  Component(store, "RiderSessionTicketStore", "ITicketStore · Telo.Ride.Api", "Keeps the session server-side; the cookie holds a key")
  Component(session, "RiderSession", "Domain entity · Telo.Ride.Domain", "Key hash, last use, expiry, end")
  ComponentDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Rider sessions")
}
Rel(current, interceptor, "Is told about 401 by")
Rel(guard, current, "Reads")
Rel(current, outbox, "Flushes after sign-in")
Rel(interceptor, cookie, "Sends requests carrying the cookie to", "HTTPS")
Rel(cookie, store, "Retrieves and renews tickets with")
Rel(store, db, "Reads and writes", "EF Core")
@enduml
