@startuml
title UML sequence behaviour — Choose a results action
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ResultsPage" as page
  participant "RiderProgressStore" as prog
  participant "Router" as router
end box
alt Done (primary)
  actor -> page : Done
  page -> prog : refresh()
  page -> router : Home
  router --> actor : Home; unlocked banner when a map opened (L2-079 AC2, L2-036)
else Race it again
  actor -> page : Race it again
  page -> router : Race Setup for the same map and mode (L2-079 AC1)
else Ride it again (class)
  actor -> page : Ride it again
  page -> router : Class Start for the class
end
@enduml
