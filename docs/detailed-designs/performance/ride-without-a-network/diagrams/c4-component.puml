@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Ride without a network

Container(api, "Telo Ride API", "ASP.NET Core", "POST /api/rides, GET /api/maps, GET /api/classes")
ContainerDb(idb, "Browser storage", "IndexedDB, Cache Storage and localStorage", "rides-waiting, ngsw caches, kept catalogues")
Container_Boundary(app, "Ride app") {
  Component(results, "ResultsPage", "Angular page · ride", "Shows XP pending")
  Component(setup, "RaceSetupPage and ClassStartPage", "Angular pages · ride", "Offer multiplayer choices")
  Component(sync, "DeviceRideOutbox", "Service · domain/storage, bound on the lazy parent route", "Keeps each ride, then submits waiting rides oldest first, with back-off")
  Component(net, "BrowserNetworkStatus", "Service · domain/browser, bound on the lazy parent route", "online signal from the window's online and offline events")
  Component(avail, "multiplayerAvailability", "Pure function · domain/engine", "open, offline or unreachable")
  Component(outbox, "IndexedDbRidesWaiting", "Service · domain/storage", "IndexedDB rides-waiting store")
  Component(ridesApi, "HttpRidesApi", "HTTP client · api", "Implements RidesApi")
  Component(register, "provideAppCache", "Environment initializer · ride, on the lazy parent route", "Registers the service worker once the first screen settles")
  Component(sw, "Angular service worker", "ngsw-worker.js", "Caches the shell and chunks at once, map art and worlds on first use, and the last progress")
}
Rel(results, sync, "Hands the finished ride to")
Rel(sync, outbox, "Adds, lists and deletes")
Rel(sync, ridesApi, "Calls submit")
Rel(setup, net, "Reads online from")
Rel(setup, avail, "Asks open, offline or unreachable")
Rel(outbox, idb, "Reads and writes")
Rel(ridesApi, sw, "Fetch passes through")
Rel(register, sw, "Registers")
Rel(sw, idb, "Caches in")
Rel(sw, api, "Forwards when online", "HTTPS")
@enduml
