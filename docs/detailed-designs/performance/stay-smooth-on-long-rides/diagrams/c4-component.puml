@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Stay smooth on long rides

ContainerDb(idb, "Browser storage", "IndexedDB", "rides waiting to send")
Container_Boundary(app, "Ride app") {
  Component(store, "RaceStore / ClassRideStore", "Screen-scoped stores · ride", "Own the ride's parts")
  Component(ticker, "RideTicker", "Service · domain/engine", "One tick a second")
  Component(recorder, "RideRecorder", "Class · domain/engine", "One speed a second in a fixed Float64Array")
  Component(outbox, "RideOutbox", "Service · domain/storage", "Persists and sends finished rides")
  Component(series, "TraceSeries", "Class · domain/engine · slice 21.3", "Decimated points, at most one per pixel")
  Component(trace, "RideTrace", "Presentation component · components · slice 21.3", "Canvas trace")
}
Rel(ticker, store, "Signals each second")
Rel(store, recorder, "Records each second in")
Rel(store, outbox, "Submits the finished ride to")
Rel(outbox, idb, "Writes", "IndexedDB")
Rel(series, trace, "Points drawn by")
@enduml
