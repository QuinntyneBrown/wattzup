@startuml
title UML sequence behaviour — Start a ride with its guards
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "Ride screen" as page
  participant "RaceStore / ClassRideStore" as store
  participant "BrowserScreenWakeLock" as wake
  end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "RideClock" as clock
  participant "RideTicker" as ticker
end box
participant "Browser" as browser
actor -> page : Start ride
page -> store : start(plan)
store -> clock : start() reads MonotonicTime.now()
store -> ticker : start()
ticker -> browser : setTimeout(to next whole second)
store -> wake : hold()
opt navigator.wakeLock exists (L2-133 AC3)
  wake -> browser : navigator.wakeLock.request('screen')
  browser --> wake : WakeLockSentinel
end
page -> browser : host listens for beforeunload
store --> page : elapsed and planState signals
...ride runs...
actor -> browser : Close or reload the tab
browser -> page : beforeunload event
page -> store : ride()?
page -> browser : event.preventDefault() (L2-133 AC4)
browser --> actor : Confirm leaving the page
alt Rider stays
  actor -> browser : Stay
else Rider leaves
  actor -> browser : Leave
  browser -> store : Route destroyed
  store -> ticker : stop() clears timer and listener
  store -> wake : release()
  browser -> page : listener removed with the screen
end
@enduml
