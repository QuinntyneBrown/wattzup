@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Keep the ride clock true

Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(bike, "Smart bike", "Echelon or FTMS bike; Bluetooth LE")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Every screen, Web Bluetooth, protocol and workout engine")
}
Rel(rider, app, "Rides with", "Touch, keyboard")
Rel(bike, app, "Notifies", "Web Bluetooth GATT")
@enduml
