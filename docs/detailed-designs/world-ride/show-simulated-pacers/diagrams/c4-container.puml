@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show simulated pacers

Person(rider, "Rider", "Watches the board")
System_Boundary(browser, "Rider's browser") {
  Container(web, "Wattzup Web", "Angular", "Computes and shows the pacer board")
  Container(lib, "@wattzup/browser", "TypeScript, in the page", "Workout engine and state store; knows no pacer")
}

Rel(rider, web, "Uses")
Rel(lib, web, "elapsed_seconds, speed_kmh", "LIVE_STATE_SOURCE")
@enduml
