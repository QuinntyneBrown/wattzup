@startuml
title Rendering quality — class structure
hide empty members
enum Tier {
  low
  medium
  high
  ultra
}
enum Backend {
  webgpu
  webgl2
}
class Technique <<interface>> {
  id: number
  name: string
  from: Tier | null
  reducedMotion: 'kept' | 'still' | 'off'
}
class "render-quality.ts" as RQ <<module>> {
  TECHNIQUES: Technique[]
  startTier(): Tier
  techniquesAt(tier, backend, reducedMotion): Set<number>
}
class FrameBudget {
  constructor(tier, periodMs)
  sample(now, frameMs): 'keep' | 'drop'
  setPeriod(ms)
  pause()
}
class "frame-period.ts" as FP <<module>> {
  estimateFramePeriod(intervals): number
}
class FrameScheduler {
  measurePeriod(frames): Promise<number>
}
class WorldRenderer <<interface>> {
  start(canvas, world): Promise<boolean>
  resize(width, height, pixelRatio)
  draw(frame)
  setFramePeriod(ms)
  pauseBudget()
  dispose()
}
RQ --> Technique
RQ ..> Tier
RQ ..> Backend
WorldRenderer ..> RQ : reads
WorldRenderer --> FrameBudget : feeds
FrameScheduler ..> FP : estimates
@enduml
