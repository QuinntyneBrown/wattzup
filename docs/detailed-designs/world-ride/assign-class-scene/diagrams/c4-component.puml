@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Assign a class scene

System_Ext(file, "classes.json", "Catalogue with world per class, beside index.html")
Container_Boundary(app, "Wattzup Web") {
  Component(classapi, "BrowserClassApi", "CLASS_API implementation", "Fetches once; answers list, get and find with world")
  Component(reader, "readCatalogue", "lib/engine", "Applies L2-077 and L2-100")
  Component(worlds, "WORLDS", "lib/engine", "The six scene ids")
  Component(wapi, "BrowserWorkoutApi", "WORKOUT_API implementation", "start(plan with class_id)")
  Component(engine, "WorkoutEngine", "lib/engine", "Runs the workout, keeps its RideOrigin")
  Component(store, "BikeStateStore", "lib/engine", "Publishes workout with class_id")
}

Rel(classapi, file, "fetch", "HTTPS, same origin")
Rel(classapi, reader, "readCatalogue(text)")
Rel(reader, worlds, "WORLDS.includes(world)")
Rel(wapi, classapi, "find(class_id)")
Rel(wapi, engine, "startWorkout(plan, origin)")
Rel(engine, store, "update(workout) with class_id")
@enduml
