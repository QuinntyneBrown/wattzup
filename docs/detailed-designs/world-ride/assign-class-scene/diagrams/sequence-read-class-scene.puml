@startuml
title UML sequence behaviour — Read a class's scene
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Owner" as owner
box "Hosting — Static host" #FFF4E5
  participant "classes.json" as file
end box
box "Frontend — Wattzup Web" #E0F2FE
  participant "Class page" as page
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserClassApi" as api
  participant "readCatalogue" as reader
  participant "WORLDS" as worlds
end box

owner -> file : Publish "world": "oldtown" on a class
page -> api : CLASS_API.get(id)
api -> file : fetch classes.json (first call of the page)
file --> api : text
api -> reader : readCatalogue(text)
loop each class
  alt "world" missing or null
    reader -> reader : world = null [L2-100 AC1]
  else WORLDS includes the value
    reader -> worlds : includes(value)
    worlds --> reader : true
    reader -> reader : world = value [L2-100 AC1]
  else any other value (unknown id, wrong case, number, object)
    reader -> reader : Leave the class out; problem (id, "world") [L2-100 AC2, L2-077 AC3]
  end
end
reader --> api : CatalogueLoadResult
api -> api : console.warn per problem [L2-096 AC2]
api --> page : ClassEntry {…, plan, world} [L2-078, L2-100 AC1]
@enduml
