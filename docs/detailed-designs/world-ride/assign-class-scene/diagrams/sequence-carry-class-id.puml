@startuml
title UML sequence behaviour — Carry the class of a running workout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "ClassPage" as classpage
  participant "LiveStateService" as live
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "BrowserWorkoutApi" as wapi
  participant "BrowserClassApi" as classes
  participant "WorkoutEngine" as engine
  participant "WorkoutRun" as run
  participant "BikeStateStore" as state
  participant "BrowserStateSource" as source
end box

classpage -> wapi : WORKOUT_API.start({plan, class_id: "30-minute-hiit-cardio"})
wapi -> classes : find(class_id) [L2-081 AC7]
classes --> wapi : ClassEntry
wapi -> engine : startWorkout(plan, {classId, title})
engine -> run : new WorkoutRun(plan, origin)
loop each tick and change
  engine -> run : toSnapshot()
  run --> engine : WorkoutSnapshot {class_id: origin?.classId ?? null} [L2-102 AC5]
  engine -> state : update(workout)
  state -> source : new state
  source --> live : state {workout: {…, class_id}} [L2-014, L2-093]
end
wapi --> classpage : WorkoutSnapshot
note over run
  A ride from /setup has no origin,
  so class_id is null.
end note
@enduml
