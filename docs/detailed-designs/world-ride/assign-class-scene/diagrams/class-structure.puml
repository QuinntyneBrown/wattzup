@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Assign a class scene

enum WorldId {
  docklands
  granite
  oldtown
  prairie
  dolomites
  coast
}
class "class-catalogue-reader.ts" as reader <<module>> {
  +WORLDS: readonly WorldId[]
  +readCatalogue(text, bytes?): CatalogueLoadResult
}
class CatalogueClass <<interface>> {
  +id: string
  +title: string
  +channel: string
  +focus: string
  +description: string
  +shelfId: string
  +plan: WorkoutPlan
  +world: WorldId | null
}
class CatalogueEntryProblem <<interface>> {
  +entry: string
  +field: string
  +message: string
}
class ClassEntry <<schema.d.ts ClassResponse>> {
  +id: string
  +title: string
  +channel: string
  +focus: string
  +description: string
  +shelf: ShelfRef
  +plan: WorkoutPlan
  +world: WorldId | null
}
class BrowserClassApi {
  +list(): Promise<ClassCatalogue>
  +get(id): Promise<ClassEntry | 'not-found'>
  +find(id): Promise<ClassEntry | null>
}
class RideOrigin <<interface>> {
  +classId: string
  +title: string
}
class WorkoutRun {
  +origin: RideOrigin | null
  +sessionId: string | null
  +toSnapshot(): WorkoutSnapshot
}
class WorkoutSnapshot <<schema.d.ts>> {
  +plan: WorkoutPlan
  +status: WorkoutStatus
  +elapsed_seconds: number
  +session_id: string | null
  +class_id: string | null
}

reader ..> WorldId : checks world against WORLDS
reader ..> CatalogueClass : builds
reader ..> CatalogueEntryProblem : reports
CatalogueClass --> WorldId
BrowserClassApi ..> CatalogueClass : copies world into
BrowserClassApi ..> ClassEntry : answers
WorkoutRun --> "0..1" RideOrigin : started from
WorkoutRun ..> WorkoutSnapshot : class_id = origin?.classId ?? null
@enduml
