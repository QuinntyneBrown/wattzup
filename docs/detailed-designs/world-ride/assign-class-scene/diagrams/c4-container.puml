@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Assign a class scene

Person(owner, "Owner", "Edits classes.json")
Person(rider, "Rider", "Rides a class")
System_Ext(host, "Static host", "classes.json: shelves and classes, each with an optional world")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web", "Angular + @wattzup/browser", "Reads each class's scene; runs the workout and publishes workout.class_id")
}

Rel(owner, host, "Replaces classes.json on")
Rel(rider, app, "Uses")
Rel(app, host, "fetch classes.json", "HTTPS, same origin")
@enduml
