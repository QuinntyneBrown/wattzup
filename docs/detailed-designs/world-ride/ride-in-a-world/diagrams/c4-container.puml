@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Ride in a world

Person(rider, "Rider", "Rides a class")
System_Ext(host, "Static host", "index.html, the World Ride chunk, classes.json")
System_Boundary(browser, "Rider's browser") {
  Container(app, "Wattzup Web", "Angular", "World Ride at /classes/:id/world")
  Container(lib, "@wattzup/browser", "TypeScript, in the page", "CLASS_API, WORKOUT_API, BIKE_API, LIVE_STATE_SOURCE: catalogue, workout engine, bike link")
}
System_Ext(bike, "Echelon bike", "BLE")

Rel(rider, app, "Uses")
Rel(app, lib, "CLASS_API.get(id); WORKOUT_API.pause, resume, stop; BIKE_API.setResistance, reconnect; live state", "Contract calls")
Rel(lib, host, "fetch classes.json", "HTTPS, same origin")
Rel(lib, bike, "Drives", "Web Bluetooth")
@enduml
