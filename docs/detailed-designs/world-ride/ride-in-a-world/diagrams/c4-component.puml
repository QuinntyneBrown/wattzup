@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Ride in a world

Container_Boundary(web, "Wattzup Web") {
  Component(classpage, "ClassPage", "Angular component", "Start ride and Ride in <world name>")
  Component(page, "WorldRidePage", "Angular component", "Route classes/:id/world")
  Component(access, "world-ride-access.ts", "Pure helper", "show or class-page")
  Component(view, "world-ride-view.ts", "Pure helper", "Builds WorldRideView")
  Component(worlds, "worlds.ts", "Pure data", "Name, route, effort name per world")
  Component(hud, "WorldRide", "Presentation component", "world-ride block: app bar, panels, overlays")
  Component(scene, "WorldScene", "Angular component", "The 3D scene (draw-class-scene)")
  Component(live, "LiveStateService", "Angular service", "Live state")
  Component(countdown, "CountdownService", "Angular service", "Interpolated clock and countdown")
  Component(actions, "RideActions", "Angular service", "Pause, resume, end, reconnect")
  Component(resistance, "ResistanceCommandService", "Angular service", "set(level)")
}
Container_Boundary(lib, "@wattzup/browser") {
  Component(contracts, "BrowserClassApi, BrowserWorkoutApi, BrowserBikeApi", "Contract implementations", "CLASS_API, WORKOUT_API, BIKE_API")
  Component(source, "BrowserStateSource", "LIVE_STATE_SOURCE implementation", "Forwards each new state")
  Component(engine, "WorkoutEngine, BikeStateStore, BikeLink", "lib/engine, lib/bluetooth", "Run the ride and drive the bike")
}

Rel(classpage, page, "Navigates to on success")
Rel(page, contracts, "CLASS_API.get(id)")
Rel(page, live, "Reads state")
Rel(live, source, "Reads")
Rel(page, access, "Decides with")
Rel(page, view, "Builds the HUD view with")
Rel(view, worlds, "Reads the world from")
Rel(page, countdown, "Reads the clock from")
Rel(page, hud, "Renders")
Rel(hud, scene, "Projects in the scene slot")
Rel(page, actions, "pause, resume, end, reconnect")
Rel(page, resistance, "set(level)")
Rel(actions, contracts, "WORKOUT_API.pause, resume; BIKE_API.reconnect")
Rel(resistance, contracts, "BIKE_API.setResistance(level)")
Rel(contracts, engine, "Commands")
Rel(source, engine, "Subscribes to the store")
@enduml
