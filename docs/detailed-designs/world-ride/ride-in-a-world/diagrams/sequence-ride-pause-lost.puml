@startuml
title UML sequence behaviour — Ride, pause and lose the bike
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "WorldRide" as hud
  participant "WorldRidePage" as page
  participant "world-ride-view.ts" as view
  participant "LiveStateService" as live
  participant "RideActions" as actions
  participant "ResistanceCommandService" as res
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WORKOUT_API, BIKE_API" as contracts
  participant "WorkoutEngine and BikeLink" as engine
end box

live --> page : new state
page -> view : worldRideView(state, entry, world)
view --> page : WorldRideView [L2-103, L2-104, L2-105]
page -> hud : view, clock, countdown
rider -> hud : Raise resistance
hud -> page : stepped(1)
page -> res : set(stepLevel(state, 1))
res -> contracts : BIKE_API.setResistance(level) [L2-108 AC2, L2-047]
contracts -> engine : setManual(level)
rider -> hud : Pause
hud -> page : pauseToggled
page -> actions : pause()
actions -> contracts : WORKOUT_API.pause() [L2-046]
contracts -> engine : pause()
engine --> live : status paused
live --> page : new state
page -> hud : overlay paused: Paused on Cathedral Circuit [L2-109 AC1]
engine --> live : status paused: bike disconnected
live --> page : new state
page -> hud : overlay lost: Lost the bike, parked at 1.61 km [L2-109 AC2]
hud -> hud : HUD inert; focus on Reconnect [L2-109 AC4]
rider -> hud : Reconnect
hud -> page : reconnected
page -> actions : reconnect()
actions -> contracts : BIKE_API.reconnect() [L2-004 AC5]
contracts -> engine : link.reconnect()
engine --> live : ble connected
live --> page : new state
page -> hud : overlay closed; focus to the app bar [L2-109 AC3, AC4]
@enduml
