@startuml
title UML sequence behaviour — Open World Ride from the class page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Rider" as rider
box "Frontend — Wattzup Web" #E0F2FE
  participant "ClassPage" as classpage
  participant "WorldRidePage" as page
  participant "LiveStateService" as live
  participant "world-ride-access.ts" as access
end box
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WORKOUT_API\n(BrowserWorkoutApi)" as workouts
  participant "WorkoutEngine" as engine
  participant "CLASS_API\n(BrowserClassApi)" as classes
end box

rider -> classpage : Ride in Old Town Criterium [L2-102 AC1]
classpage -> classpage : start(inWorld); replace-ride dialog first if a ride is active [L2-052]
classpage -> workouts : start(plan + video + class_id)
workouts -> engine : startWorkout(plan, origin)
engine -> live : publishes the new ride {status, class_id}
engine --> workouts : WorkoutSnapshot
workouts --> classpage : started
classpage -> page : Navigate to /classes/<id>/world [L2-102 AC2]
page -> classes : get(id)
alt not-found
  classes --> page : 'not-found'
  page --> rider : We can't find that class [L2-102 AC4, L2-080 AC13]
else class
  classes --> page : ClassEntry {…, world}
  page -> live : state held when the page opens
  live --> page : workout {status, class_id}
  page -> access : worldRideAccess(id, entry, workout), once
  alt show
    access --> page : show
    page --> rider : World Ride in the class's world, titled by its name [L2-102 AC3]
  else class-page
    access --> page : class-page
    page --> rider : Replace URL with /classes/<id> [L2-102 AC4]
  end
end
@enduml
