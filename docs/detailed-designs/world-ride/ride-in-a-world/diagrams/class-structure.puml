@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Ride in a world

enum WorldRideAccess {
  show
  class-page
}
class WorldRideOverlay <<interface>> {
  +kind: paused | lost | ended
  +title: string
  +text: string
  +sessionHref: string | null
}
class WorldRideView <<interface>> {
  +title: string
  +classLine: string
  +bike: string | null
  +paused: boolean
  +metrics: WorldRideMetrics
  +segment: WorldRideSegment | null
  +resistance: WorldRideResistance
  +pacers: WorldRidePacer[]
  +profile: WorldRideProfile | null
  +overlay: WorldRideOverlay | null
}
class "world-ride-access.ts" as access <<module>> {
  +worldRideAccess(routeId, entry, workout): WorldRideAccess
}
class "world-ride-view.ts" as viewfn <<module>> {
  +worldRideView(state, entry, world): WorldRideView
}
class World <<interface>> {
  +id: WorldId
  +name: string
  +route: string
  +effortName: string
}
class WorldRide <<component>> {
  +view: input<WorldRideView>
  +clock: input<WorldRideClock>
  +countdown: input<WorldRideCountdown>
  +classHref: input<string>
  +homeHref: input<string>
  +reconnecting: input<boolean>
  +sceneUnavailable: input<boolean>
  +pauseToggled: output<void>
  +endRequested: output<void>
  +stepped: output<-1 | 1>
  +navigate: output<string>
  +sessionOpened: output<string>
  +reconnected: output<void>
}
class WorldRidePage <<component>> {
  +id: input<string>
  -entry: Signal<ClassEntry | null>
  -shown: Signal<boolean>
  -step(delta): void
}
class RideActions <<service>> {
  +pause(): Promise<void>
  +resume(): Promise<void>
  +end(): void
  +reconnect(): Promise<void>
}
class ResistanceCommandService <<service>> {
  +set(level): Promise<void>
}
interface WORKOUT_API <<token>>
interface BIKE_API <<token>>

access --> WorldRideAccess : returns
viewfn --> WorldRideView : builds
viewfn ..> World : reads
WorldRideView --> WorldRideOverlay
WorldRidePage ..> access : decides with
WorldRidePage ..> viewfn : builds with
WorldRidePage *-- WorldRide : renders
WorldRide --> WorldRideView : shows
WorldRidePage ..> RideActions : commands
WorldRidePage ..> ResistanceCommandService : sets level
RideActions ..> WORKOUT_API : pause, resume
RideActions ..> BIKE_API : reconnect
ResistanceCommandService ..> BIKE_API : setResistance
@enduml
