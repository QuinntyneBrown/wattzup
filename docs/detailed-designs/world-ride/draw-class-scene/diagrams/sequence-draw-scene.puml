@startuml
title UML sequence behaviour — Draw the scene each frame
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — Wattzup Web" #E0F2FE
  participant "WorldRidePage" as page
  participant "WorldScene" as scene
  participant "WorldRenderer" as renderer
  participant "FrameScheduler" as frames
  participant "MotionPreference" as motion
  participant "WorldRide" as hud
end box

page -> scene : world, segments, elapsed, speedKmh, running
scene -> renderer : WORLD_RENDERER loader: import('core/world-renderer') [L2-102 AC8]
scene -> renderer : start(canvas, world)
alt neither WebGPU nor WebGL2 starts
  renderer --> scene : false
  scene -> page : unavailable
  page -> hud : sceneUnavailable = true
  hud -> hud : This screen can't draw 3D worlds / The ride still runs on the numbers. [L2-110 AC4]
else started
  renderer --> scene : true
  scene -> frames : startLoop()
  loop each frame while the tab is shown [L2-110 AC5]
    frames --> scene : now
    alt running
      scene -> scene : s += speedKmh / 3.6 × dt [L2-110 AC1]
    else paused or waiting
      scene -> scene : s unchanged [L2-109 AC1]
    end
    scene -> motion : reduced()
    motion --> scene : true or false
    scene -> renderer : draw({s, crank, segments, elapsed, speedKmh, reducedMotion})
    renderer -> renderer : Lay road ahead from the plan; ease to targetGrade per 2 m [L2-101 AC2]
    renderer -> renderer : Effort arch: effort name before work, Finish before the end [L2-110 AC2]
    renderer -> renderer : No sway or pedalling with reducedMotion [L2-110 AC6]
  end
  note over frames
    While the tab is hidden, no frame is requested;
    the loop resumes when it is shown.
  end note
end
page -> scene : leave World Ride
scene -> renderer : dispose()
@enduml
