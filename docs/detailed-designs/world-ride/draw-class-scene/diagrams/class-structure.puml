@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Draw the class scene

enum WorldId {
  docklands
  granite
  oldtown
  prairie
  dolomites
  coast
}
class World <<interface>> {
  +id: WorldId
  +name: string
  +route: string
  +effortName: string
  +description: string
  +grade: Record<SegmentKind, number>
  +roll: number
  +look: WorldLook
}
class WorldLook <<interface>> {
  +sky, fog, sun, ground, road
  +snowline: number | null
  +curve: number
  +hills: number
  +sea: string | null
  +props: PropSpec[]
  +panorama: string
  +textures: string[]
}
class "worlds.ts" as worldsmod <<module>> {
  +WORLDS: readonly World[]
  +worldById(id: WorldId): World
  +targetGrade(world, kind, s): number
}
class RouteProfile <<interface>> {
  +elevation: number[]
  +grade: number[]
  +climbed: number[]
  +metres: number
}
class RouteProfileView <<interface>> {
  +gradeText: string
  +climbedText: string
  +areaPath: string
  +doneWidth: number
  +strip: StripRect[]
  +playheadX: number
  +label: string
}
class "route-profile.ts" as profilemod <<module>> {
  +expectedSpeed(segment): number
  +routeProfile(world, segments): RouteProfile
  +profileAt(profile, t): {grade, climbed}
  +routeProfileView(profile, segments, t): RouteProfileView
}
class SceneFrame <<interface>> {
  +s: number
  +crank: number
  +segments: Segment[]
  +elapsed: number
  +speedKmh: number
  +reducedMotion: boolean
}
class WorldRenderer {
  +start(canvas, world): Promise<boolean>
  +resize(width, height, pixelRatio): void
  +draw(frame: SceneFrame): void
  +dispose(): void
}
class WorldScene <<component>> {
  +world: input<World>
  +segments: input<Segment[]>
  +elapsed: input<number>
  +speedKmh: input<number>
  +running: input<boolean>
  +unavailable: output<void>
}

World --> WorldId
World *-- WorldLook
worldsmod --> World : holds
profilemod ..> worldsmod : targetGrade
profilemod --> RouteProfile : builds
profilemod --> RouteProfileView : builds
WorldScene ..> WorldRenderer : loads on demand
WorldRenderer ..> SceneFrame : draws
WorldRenderer ..> World : reads look and grade
@enduml
