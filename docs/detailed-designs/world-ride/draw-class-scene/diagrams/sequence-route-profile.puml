@startuml
title UML sequence behaviour — Show the route profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Frontend — @wattzup/browser" #ECFDF3
  participant "WorkoutEngine and BikeStateStore" as engine
end box
box "Frontend — Wattzup Web" #E0F2FE
  participant "LiveStateService" as live
  participant "WorldRidePage" as page
  participant "world-ride-view.ts" as view
  participant "route-profile.ts" as profile
  participant "worlds.ts" as worlds
  participant "WorldRide" as hud
end box

engine --> live : new state [L2-093]
live --> page : state {workout.segments, elapsed_seconds, distance_km, status}
page -> view : worldRideView(state, entry, world)
view -> profile : routeProfile(world, segments)
loop each second of the plan
  profile -> worlds : targetGrade(world, kind, s)
  worlds --> profile : percent
  profile -> profile : g += (target - g) × 0.12; rise = g / 100 × v; s += v [L2-101 AC3]
end
profile --> view : RouteProfile
view -> profile : routeProfileView(profile, segments, elapsed_seconds)
profile --> view : +0.5%, 10 m climbed, area, done width, strip, playhead, label [L2-106 AC1 to AC3]
view --> page : view with profile and distance 1.61 km
page -> hud : view
note over page
  elapsed_seconds does not change while the ride is
  not running, so the panel holds still [L2-106 AC4].
end note
@enduml
