@startuml
title UML sequence behaviour — Change resistance by hand
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "Ride page" as page
  participant "RideStep / RideLevels" as ctl
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "ResistanceController" as ctrl
  participant "SentToBikeLog" as sent
  participant "WebBluetoothBikeConnection" as conn
end box
box "Device — Smart bike" #F2F4F7
  participant "Bike GATT server" as bike
end box
alt no connected bike, or a read-only FTMS bike
  page -> ctl : disabled = true
  ctl --> actor : Every −, + and level bar disabled (L2-028 AC4)
  ctl --> actor : "Nothing sent — no bike connected." (L2-029 AC2)
else connected with control
  alt Raise resistance or Lower resistance
    actor -> ctl : Press +
    ctl -> page : raise
    page -> ctrl : nudge(+1)
  else Level N bar on Custom ride
    actor -> ctl : Press "Level 20"
    ctl -> page : pick(20)
    page -> ctrl : setManual(20) (L2-028 AC2)
  end
  ctrl -> ctrl : clamp to 1..32, source = Manual (L2-025 AC2, L2-028 AC1)
  ctrl -> conn : setResistance(level)
  conn -> bike : B1 command, with response
  bike --> conn : Acknowledged
  conn --> ctrl : ack ms
  ctrl -> sent : add({rideTime, level, manual, ack})
  ctrl --> ctl : target = level; bar has aria-current="true", bars below on
  ctl --> actor : Stepper readout labelled "Resistance {n} of 32" (L2-028 AC5)
end
@enduml
