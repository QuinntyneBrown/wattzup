@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Connect a bike
Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Every screen, Web Bluetooth, protocol and workout engine")
  ContainerDb(idb, "Browser storage", "IndexedDB", "The remembered bike's id, name and kind")
}
Rel(rider, app, "Searches and pairs in")
Rel(app, bike, "Connects and writes commands", "Web Bluetooth GATT")
Rel(app, idb, "Remembers the paired bike in")
@enduml
