@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Ride a custom workout

Person(rider, "Rider", "Rides a smart bike at home")
System(telo, "Telo Ride", "Smart-bike game: races, classes and progression")
System_Ext(bike, "Smart bike", "Echelon EX-5s, EX-3, EX-8s, Connect Sport, or an FTMS bike; Bluetooth LE")
System_Ext(strap, "Heart-rate strap", "Bluetooth Heart Rate Service")
