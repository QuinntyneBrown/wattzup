@startuml
title UML sequence behaviour — Start the custom ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "PlanPreview" as preview
  participant "CustomWorkoutStore" as store
  participant "Router" as router
end box
box "Frontend — Ride app (api, domain and video libraries)" #E0F2FE
  participant "SettingsStore" as settings
  participant "HttpCustomWorkoutApi" as capi
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "CustomWorkoutController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SaveCustomWorkoutCommandValidator" as val
  participant "SaveCustomWorkoutCommandHandler" as handler
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  database "Telo Ride database" as db
end box
rider -> preview : Press "Start ride"
preview -> store : start()
store -> settings : Save draft on the device (L2-135 AC3)
store -> capi : save(dto)
capi -> ctrl : PUT /api/riders/me/custom-workout
ctrl -> val : Validate SaveCustomWorkoutCommand
alt plan valid
  val --> ctrl : Valid
  ctrl -> handler : Send SaveCustomWorkoutCommand
  handler -> db : Upsert CustomWorkout for the rider
  db --> handler : Saved
  handler --> ctrl : Done
  ctrl --> capi : 204 No Content
else plan invalid
  val --> ctrl : Invalid
  ctrl --> capi : 400 ProblemDetails code plan_invalid
end
store -> router : Navigate to /profile/custom/ride with this plan L2-099 AC4
router --> rider : Custom ride (draft shared by the parent route)
@enduml
