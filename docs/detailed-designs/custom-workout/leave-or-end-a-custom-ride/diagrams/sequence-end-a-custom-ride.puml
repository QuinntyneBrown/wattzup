@startuml
title UML sequence behaviour — End a custom ride
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as rider
box "Frontend — Ride app (ride application and components library)" #E0F2FE
  participant "RideHeader" as header
  participant "CustomRideStore" as store
  participant "Router" as router
end box
box "Frontend — Ride app (api, domain and video libraries)" #E0F2FE
  participant "RideRecorder" as recorder
  participant "RideOutbox" as outbox
  participant "HttpRidesApi" as rapi
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RidesController" as ctrl
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SubmitRideCommandHandler" as handler
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  database "Telo Ride database" as db
end box
alt rider presses End (also while the bike is lost, L2-105 AC4)
  rider -> header : Press End
  header -> store : end()
else clock reaches the plan's length L2-108 AC2
  store -> store : end()
end
store -> recorder : durationSeconds
alt under one minute L2-108 AC3
  recorder --> store : 42 s
  store -> store : Discard
  store -> router : Navigate to /profile with ProfileNotice "too short" (copy <TO SUPPLY>)
else one minute or more
  recorder --> store : 1,800 s
  store -> recorder : toSubmission(custom)
  recorder --> store : RideSubmission
  store -> outbox : enqueue(submission) (IndexedDB)
  outbox -> rapi : submit(submission)
  rapi -> ctrl : POST /api/rides
  ctrl -> handler : Send SubmitRideCommand
  handler -> db : Record once per ride id; XP without place lines (L2-037 AC6)
  db --> handler : Saved
  handler --> ctrl : RideResultDto
  ctrl --> rapi : 200 OK
  rapi --> outbox : Recorded; remove from IndexedDB
  store -> router : Navigate to /profile (no confirmation) L2-108 AC1
end
router --> rider : Profile
@enduml
