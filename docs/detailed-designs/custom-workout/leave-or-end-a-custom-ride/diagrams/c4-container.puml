@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Leave or end a custom ride

Person(rider, "Rider", "Rides a smart bike at home")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Custom ride, leave popover, outbox")
  ContainerDb(idb, "Browser storage", "IndexedDB", "Rides waiting to send")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Records rides, computes progress")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Rides and progress")
}
Rel(rider, app, "Uses")
Rel(app, idb, "Keeps the ride until recorded")
Rel(app, api, "POST /api/rides", "JSON/HTTPS")
Rel(api, db, "Records once per ride id", "EF Core")
@enduml
