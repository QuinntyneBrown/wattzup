@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Earn stars and unlock maps

Container(app, "Ride app", "Angular", "Home, Map Select, Race Setup, Results, Profile")
Container_Boundary(api, "Telo Ride API") {
  Component(rides, "RidesController", "ASP.NET Core controller", "POST /api/rides")
  Component(progress, "ProgressController", "ASP.NET Core controller", "GET /api/progress")
  Component(submit, "SubmitRideCommandHandler", "MediatR handler", "Applies stars and unlocks to a recorded race")
  Component(query, "GetProgressQueryHandler", "MediatR handler", "Reports stars, bests, open maps and the next unlock")
  Component(stars, "StarRules", "Domain service", "Three stars per map")
  Component(unlocks, "UnlockRules", "Domain service", "Goals, unlocks and the next unlock")
  Component(mp, "MapProgress", "Domain entity", "Stars, best time, opened and seen times per rider and map")
  Component(maps, "MapDefinition", "Domain entity", "Catalogue entry with unlock order and goal")
}
ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Map progress and map definitions")

Rel(app, rides, "Submits race", "JSON/HTTPS")
Rel(app, progress, "Reads progress", "JSON/HTTPS")
Rel(rides, submit, "Sends SubmitRideCommand")
Rel(progress, query, "Sends GetProgressQuery")
Rel(submit, stars, "Evaluates")
Rel(submit, unlocks, "Evaluates")
Rel(query, unlocks, "NextUnlock")
Rel(mp, stars, "Asks for the stars a finish earns")
Rel(unlocks, maps, "Reads goals of")
Rel(unlocks, mp, "Opens")
Rel(submit, db, "Saves", "EF Core")
Rel(query, db, "Reads", "EF Core")
@enduml
