@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Wait in the race lobby
Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(bike, "Smart bike", "Echelon or FTMS; Bluetooth LE")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Every screen, Web Bluetooth, protocol and workout engine")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Ride hub owns riders-online sessions")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Riders and display names")
}
Rel(rider, app, "Uses")
Rel(app, api, "FindRace, SetReady, LeaveRace; receives SeatsChanged", "SignalR")
Rel(app, bike, "Writes target resistance", "Web Bluetooth")
Rel(api, db, "Reads rider names and levels", "EF Core")
@enduml
