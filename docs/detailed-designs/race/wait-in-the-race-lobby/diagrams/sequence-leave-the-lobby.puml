@startuml
title UML sequence behaviour — Leave the lobby
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "RaceLobbyPage" as page
  participant "LobbyStore" as store
  participant "LiveSessionStore" as session
  participant "Router" as router
end box
box "Frontend — Ride app (api library)" #E0F2FE
  participant "RideHubClient" as hub
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHub" as ridehub
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "RaceSession" as rs
end box
alt rider presses "Leave"
  actor -> page : Press "Leave"
  page -> store : leave()
  opt riders-online lobby
    store -> session : leaveRace()
    session -> hub : LeaveRace(sessionId)
    hub -> ridehub : LeaveRace
    ridehub -> rs : Release seat (L2-055 AC1, AC2)
  end
  page -> router : The Leave link opens /race/:mapId?mode=<same mode>, no confirmation (L2-057 AC1)
  router -> session : The lobby route goes; stop() closes the connection
  router --> actor : Race Setup with the same mode
else rider closes the tab
  ridehub -> ridehub : Connection lost
  ridehub -> rs : After 10 s without the connection, release seat (L2-057 AC2)
  ridehub -> ridehub : SeatsChanged with left to the others
end
@enduml
