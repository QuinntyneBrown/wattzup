@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Check this device
Person(rider, "Rider", "Rides a smart bike at home")
Container_Boundary(app, "Ride app") {
  Component(page, "SettingsPage / DeviceCheck", "Page · ride; presentation · components", "Check this device, its progress and result")
  Component(store, "DeviceCheckStore", "Service · ride (Settings page)", "Runs the check, stops it when hidden, keeps the result")
  Component(words, "deviceCheckLevels() / deviceCheckRunning() / deviceCheckResult()", "Pure helpers · domain/engine", "Levels to try and the words")
  Component(settings, "LocalRideSettingsStore", "Service · domain/storage (RIDE_SETTINGS)", "deviceCheck, read by worldQuality() for Auto")
  Component(runner, "WorldDeviceCheck", "world (lazy, DEVICE_CHECK)", "Trials off screen")
  Component(main, "FrameScheduler / WorldRenderer / SceneDriver / heldFps", "world (main's)", "Display period, frames, the test world at a level")
}
Rel(rider, page, "Starts or stops")
Rel(page, store, "start, stop")
Rel(page, words, "Words")
Rel(store, words, "deviceCheckLevels(api, graphics)")
Rel(store, runner, "run(levels, forceWebGL, progress, signal)")
Rel(store, settings, "set('deviceCheck', result)")
Rel(runner, main, "measurePeriod, nextFrame, start, draw, dispose")
@enduml
