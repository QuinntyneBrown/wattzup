@startuml
set separator none
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Restrict third parties
package "Telo.Ride.Api" {
  class "security-headers.json" as File <<embedded resource>> {
    +Content-Security-Policy: directive → sources
    +X-Content-Type-Options = "nosniff"
    +Referrer-Policy = "strict-origin-when-cross-origin"
  }
  class ContentSecurityPolicy <<header value>> {
    +default-src 'self'
    +script-src 'self' https://www.youtube.com 'wasm-unsafe-eval'
    +style-src 'self' 'unsafe-inline'
    +font-src 'self'
    +img-src 'self' https://i.ytimg.com https://tile.googleapis.com blob:
    +connect-src 'self' https://tile.googleapis.com blob:
    +worker-src 'self' blob:
    +frame-src https://www.youtube-nocookie.com
    +object-src 'none'
    +base-uri 'self'
    +form-action 'self'
    +frame-ancestors 'none'
  }
  class SecurityHeaders <<static>> {
    +Headers: IReadOnlyDictionary<string, string>
    +UseSecurityHeaders(app): IApplicationBuilder
  }
  File *-- ContentSecurityPolicy
  SecurityHeaders ..> File : reads
}
package "frontend" {
  class "serve-dist.mjs" as Serve <<script>> {
    +sends the same headers with the build
  }
  class ContentSecurityPolicyFixture {
    -seen: string[]
    +install(page): Promise<ContentSecurityPolicyFixture>
    +take(): string[]
    +untaken(): string[]
  }
  class YouTubeVideoPlayer {
    +www.youtube.com/iframe_api
    +www.youtube-nocookie.com embeds
  }
  class PhotorealTiles {
    +tile.googleapis.com, with the rider's key
  }
}
Serve ..> File : reads
@enduml
