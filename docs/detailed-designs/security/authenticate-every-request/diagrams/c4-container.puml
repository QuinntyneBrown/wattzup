@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Authenticate every request
Person(rider, "Rider", "Rides a smart bike at home")
System_Ext(probe, "Hosting platform health probe", "Host <TO SUPPLY>")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Sends the session cookie; the browser adds Sec-Fetch-Site and Origin")
  Container(api, "Telo Ride API", "ASP.NET Core, SignalR", "Same-origin proof, fallback policy, owner scoping, health checks")
  ContainerDb(db, "Telo Ride database", "EF Core; engine <TO SUPPLY>", "Sessions and rider-owned data")
}
Rel(rider, app, "Uses", "HTTPS")
Rel(app, api, "REST and the ride hub", "JSON/HTTPS, WebSocket")
Rel(probe, api, "GET /health/live, /health/ready", "HTTPS")
Rel(api, db, "Reads sessions; reads data filtered by rider", "EF Core")
@enduml
