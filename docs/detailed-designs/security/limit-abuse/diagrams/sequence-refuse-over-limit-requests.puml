@startuml
title UML sequence behaviour — Refuse requests over a limit
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Ride app" #E0F2FE
  participant "DeviceRideOutbox" as outbox
  participant "HttpRidesApi" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RidesController" as ctrl
  participant "ProblemDetailsExceptionHandler" as errors
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "SubmitRideCommandHandler" as handler
end box
database "Telo Ride database" as db
outbox -> client : submitRide(ride)
client -> ctrl : POST /api/rides
ctrl -> handler : Send SubmitRideCommand
handler -> db : Find the ride id
alt already recorded
  handler --> ctrl : The first answer
  ctrl --> client : 200
else new
  handler -> db : The rider's rides recorded in the past hour
  alt fewer than 60
    handler -> db : Record the ride
    handler --> ctrl : RideRecordedDto
    ctrl --> client : 201
  else 60 already (L2-130 AC3)
    handler --> errors : DomainRuleException rate_limited, wait until the hour's oldest falls out
    errors --> client : 429 ProblemDetails code rate_limited, Retry-After: seconds (L2-130 AC1)
    client --> outbox : Keep the ride; send it again when Retry-After has passed
  end
end
note over handler : POST /api/auth/code limits are counted from stored codes by the\nsend-code handler and answered with the same 429 shape (L2-003).\nPOST /api/feedback answers with the same 429 shape (L2-119 AC3).
@enduml
