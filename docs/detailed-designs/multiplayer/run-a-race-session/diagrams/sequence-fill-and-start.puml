@startuml
title UML sequence behaviour — Fill seats and start together
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "LiveSessionStore" as store
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "measureClockOffset" as clock
  participant "RideClock" as rideclock
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHubNotifier" as notifier
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "TickLiveSessionsCommandHandler" as tick
  participant "RaceSession" as session
  participant "BotRoster" as roster
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  participant "SessionTicker" as ticker
  participant "InMemoryRaceSessionRegistry" as registry
end box
loop every 1 s on TimeProvider
  ticker -> tick : Send TickLiveSessionsCommand(now)
  tick -> registry : All()
  registry --> tick : Live sessions
  alt StartsAt - now <= 10 s and state Seating
    tick -> session : FillWithBots(roster)
    session -> roster : Next() for each open seat
    roster --> session : Pacer Nova, Rook, ...
    session --> tick : 10 / 10, every bot ready (L2-121 AC2)
    tick -> notifier : SeatsChanged(sessionId, seats)
    notifier --> store : SeatsChanged
  else StartsAt - now <= 3 s and state Full
    tick -> session : BeginCountdown()
    tick -> notifier : CountdownStarted(sessionId, StartsAt)
    notifier --> store : CountdownStarted(startsAt)
    store -> clock : toLocal(startsAt)
    clock --> store : Local deadline
  else now >= StartsAt
    tick -> session : Start() whether or not all are ready (L2-053 AC4)
    tick -> notifier : SessionStarted(sessionId, StartsAt)
    notifier --> store : SessionStarted(startsAt)
    store -> clock : toLocal(startsAt) with measured offset
    clock --> store : Local deadline
    store -> rideclock : Start at deadline; clocks within 250 ms (L2-121 AC3)
  end
end
@enduml
