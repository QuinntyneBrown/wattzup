@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Run a group class session

Container_Boundary(app, "Ride app") {
  Component(page, "ClassStartPage", "Angular page · ride", "Branches on the refusal code")
  Component(store, "LiveSessionStore", "Signal store · ride", "Seat, start deadline")
  Component(hubc, "SignalRRideHubClient", "SignalR client · api", "RideHubClient")
}
Container_Boundary(api, "Telo Ride API") {
  Component(hub, "RideHub", "SignalR hub · Telo.Ride.Api", "JoinClassSession")
  Component(join, "JoinClassSessionCommandHandler", "MediatR handler · Telo.Ride.Application", "Seats or refuses")
  Component(schedule, "GroupSessionSchedule", "Domain service · Telo.Ride.Domain", "A slot every 15 minutes")
  Component(session, "GroupClassSession", "Domain entity · Telo.Ride.Domain", "Up to 10 seats for one slot")
  Component(tick, "TickLiveSessionsCommandHandler", "MediatR handler · Telo.Ride.Application", "Fills bots and starts at the slot")
  Component(ticker, "SessionTicker", "BackgroundService · Telo.Ride.Infrastructure", "One tick a second")
  Component(registry, "InMemoryGroupSessionRegistry", "IGroupSessionRegistry · Telo.Ride.Infrastructure", "Live group sessions, bounded")
  Component(notifier, "RideHubNotifier", "ISessionNotifier · Telo.Ride.Api", "Sends to session:{id}")
}
Rel(page, store, "join(class, session)")
Rel(store, hubc, "joinClassSession")
Rel(hubc, hub, "Invokes", "SignalR")
Rel(hub, join, "Sends JoinClassSessionCommand")
Rel(join, schedule, "Resolves the slot")
Rel(join, registry, "Gets or creates the session")
Rel(join, session, "TrySeat(rider, now)")
Rel(ticker, tick, "Sends TickLiveSessionsCommand")
Rel(tick, session, "FillWithBots, Start")
Rel(join, notifier, "SeatsChanged")
Rel(tick, notifier, "SessionStarted")
Rel(notifier, hubc, "Pushes messages", "SignalR")
@enduml
