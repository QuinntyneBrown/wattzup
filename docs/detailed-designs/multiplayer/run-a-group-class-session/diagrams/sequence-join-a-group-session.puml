@startuml
title UML sequence behaviour — Join a group session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "ClassStartPage" as page
  participant "LiveSessionStore" as store
end box
box "Frontend — Ride app (api library)" #E0F2FE
  participant "SignalRRideHubClient" as client
end box
box "Backend — Telo.Ride.Api" #D1FADF
  participant "RideHub" as hub
  participant "RideHubNotifier" as notifier
end box
box "Backend — Telo.Ride.Application and Domain" #ECFDF3
  participant "JoinClassSessionCommandHandler" as handler
  participant "GroupSessionSchedule" as schedule
  participant "GroupClassSession" as session
end box
box "Backend — Telo.Ride.Infrastructure" #FFF4E5
  participant "InMemorySessionRegistry" as registry
  database "Telo Ride database" as db
end box
actor -> page : Choose "Join the group"
page -> store : join(classId, sessionId)
store -> client : joinClassSession(classId, sessionId)
client -> hub : JoinClassSession(classId, sessionId)
hub -> handler : Send JoinClassSessionCommand
handler -> db : Load class and rider level
db --> handler : ClassDefinition, RiderOccupant
alt rider level below OpensAtLevel
  handler --> hub : Code class_locked (L2-082)
else level allows
  handler -> schedule : Slot for sessionId
  schedule --> handler : Slot start
  handler -> registry : Get or create GroupClassSession(classId, slot)
  registry --> handler : Session
  handler -> session : TrySeat(rider, now)
  alt now before StartsAt and fewer than 10 seated
    session --> handler : Seat (L2-122 AC1)
    handler -> notifier : AddToSessionAsync, SeatsChanged
    handler --> hub : Seat assignment
  else 10 seated
    session --> handler : session_full
    handler -> schedule : Next(slot)
    handler --> hub : Code session_full + next session (L2-122 AC2)
  else start has passed
    session --> handler : session_started
    handler -> schedule : Next(slot)
    handler --> hub : Code session_started + next session (L2-086 AC3)
  end
end
hub --> client : JoinResultDto
alt seated
  client --> store : SeatAssignmentDto
  store --> page : Seated
  page --> actor : Class ride opens, waiting for the start
else refused
  client --> store : RideHubError(code, next session)
  store --> page : Refusal
  page --> actor : Next session offered
end
@enduml
