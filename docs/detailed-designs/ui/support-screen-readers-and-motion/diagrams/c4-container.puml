@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Support screen readers and motion preferences

Person(rider, "Rider", "May use a screen reader or prefer reduced motion")
System_Ext(at, "Assistive technology", "Screen reader")
System_Boundary(telo, "Telo Ride") {
  Container(app, "Ride app", "Angular, Chrome or Edge", "Every screen, Web Bluetooth, protocol and workout engine")
}
Rel(rider, app, "Uses")
Rel(at, app, "Reads", "Accessibility tree")
@enduml
