@startuml
title UML sequence behaviour — Apply the theme
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Rider" as actor
participant "Browser" as browser
box "Frontend — Ride app (ride application)" #E0F2FE
  participant "index.html and tokens.css" as doc
end box
box "Frontend — Ride app (domain library)" #E0F2FE
  participant "BrowserDisplayPreferences" as theme
end box
actor -> browser : Open Telo Ride
browser -> doc : Parse <html> with no data-theme
alt The device asks for light (L2-143 AC2)
  doc --> browser : First paint in the light theme (:root)
else It asks for dark (L2-143 AC1)
  doc --> browser : First paint in the dark theme (prefers-color-scheme: dark)
end
browser -> theme : The parent route's initializer starts it
theme -> browser : matchMedia('(prefers-color-scheme: light)') and the rider's Theme choice
theme -> doc : Set data-theme to the choice, or light when the query matches, else dark
doc --> browser : Role tokens resolve; the theme is the one already painted
actor -> browser : Change the device colour scheme
browser -> theme : change event
theme -> doc : Update data-theme
@enduml
